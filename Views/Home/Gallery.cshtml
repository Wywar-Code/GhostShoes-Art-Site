@{
    ViewData["Title"] = "Gallery";

    var artworks = new[]
    {
        new { Title = "Frankie", Medium = "Digital", ImageUrl = "/Frankie.jpg" },
        new { Title = "Lucky", Medium = "Digital", ImageUrl = "/Lucky.png" },
        new { Title = "Blathers", Medium = "Digital", ImageUrl = "/Blathers.png" },
        new { Title = "CoCo", Medium = "Digital", ImageUrl = "/CoCo.png" },
        new { Title = "Ekko", Medium = "Digital", ImageUrl = "/Ekko.jpg" },
        new { Title = "Cherry", Medium = "Digital", ImageUrl = "/Cherry.jpg" },
        new { Title = "Clawdeen", Medium = "Digital", ImageUrl = "/Clawdeen.png" },
        new { Title = "Cleo", Medium = "Digital", ImageUrl = "/Cleo.png" },
        new { Title = "Grizzly", Medium = "Digital", ImageUrl = "/Grizzly.jpg" },
        new { Title = "Tongs", Medium = "Digital", ImageUrl = "/tongs.jpg" },
    };
}

<div class="container py-5">
    <h1 class="page-header mb-4 text-center">Gallery</h1>

    <div class="row g-4">
        @foreach (var art in artworks)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100">
                    @if (string.IsNullOrEmpty(art.ImageUrl))
                    {
                        <div class="d-flex align-items-center justify-content-center bg-secondary text-white"
                             style="height: 250px;">
                            <span>Artwork Placeholder</span>
                        </div>
                    }
                    else
                    {
                        <img src="@art.ImageUrl" class="card-img-top" alt="@art.Title"
                             style="width: 100%; height: auto;" />
                    }
                    <div class="card-body py-2">
                        <p class="card-text small mb-0">@art.Title</p>
                        <p class="card-text small text-muted mb-0">@art.Medium</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>